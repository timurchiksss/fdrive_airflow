AIRFLOW_UID=50000

# Airflow UI default user is created by airflow-init:
# username: admin
# password: admin

# Raw target database. Defaults below use the postgres service from docker-compose.yaml.
RAW_PGHOST=postgres
RAW_PGPORT=5432
RAW_PGUSER=airflow
RAW_PGPASSWORD=airflow
RAW_PGDATABASE=airflow
RAW_SCHEMA=raw
CLEAN_SCHEMA=cleanned
MATCH_SCHEMA=matching

# Optional parser tuning.
PARSER_MAX_ROWS=15000
PARSER_WORKERS=6
PITSTOP_ROOTS=tyre,gruz,sh,moto,atv
F7_MAX_PRODUCTS=15000
FDRIVE_MAX_PRODUCTS=15000
SHINLINE_MAX_PRODUCTS=15000
ALMATYRES_MAX_PRODUCTS=15000
CARCITY_MAX_PRODUCTS=15000
PITSTOP_MAX_PRODUCTS=15000
SATU_MAX_PRODUCTS=15000
SATU_MAX_PAGES=1000
SATU_SKIP_DETAILS=false
SATU_DIRECT_HTTP=true
FORTE_MAX_PRODUCTS=15000
FORTE_SKIP_DETAILS=false

# Optional project integrations.
SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=/opt/airflow/secrets/service-account.json
CHAT_ID=
BOT_URL=
